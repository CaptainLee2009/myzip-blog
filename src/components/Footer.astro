---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<strong>MyZip</strong>
			<p>
				A hyper-local agentic timeline built for your neighborhood. MyZip is an independent project
				operated by its founder.
			</p>
		</div>
		<div class="footer-links">
			<div>
				<h4>Explore Live</h4>
				<ul>
					<li><a href="https://my.zip/us/94107" target="_blank" rel="noopener">SF SoMa · 94107</a></li>
					<li><a href="https://my.zip/us/94102" target="_blank" rel="noopener">SF Civic Center · 94102</a></li>
					<li><a href="https://my.zip/us/95129" target="_blank" rel="noopener">Cupertino · 95129</a></li>
					<li><a href="https://my.zip" target="_blank" rel="noopener">Open my.zip</a></li>
				</ul>
			</div>
			<div>
				<h4>Blog</h4>
				<ul>
					<li><a href="/blog">All Stories</a></li>
					<li><a href="/about">About</a></li>
					<li><a href="/rss.xml">RSS Feed</a></li>
					<li><a href="https://github.com/CaptainLee2009/myzip-blog" target="_blank" rel="noopener">GitHub</a></li>
				</ul>
			</div>
			<div>
				<h4>Trust &amp; Legal</h4>
				<ul>
					<li><a href="https://my.zip/legal/privacy" target="_blank" rel="noopener">Privacy Policy</a></li>
					<li><a href="https://my.zip/legal/terms" target="_blank" rel="noopener">Terms of Service</a></li>
				</ul>
			</div>
		</div>
	</div>
	<div class="footer-bottom">
		<span>&copy; {today.getFullYear()} MyZip. Built in public for real neighborhoods.</span>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		color: var(--ink-subtle);
		font-size: 0.9rem;
		margin-top: 3rem;
	}
	.footer-inner {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 3rem 1.25rem 2rem;
		display: grid;
		grid-template-columns: 1.3fr 2fr;
		gap: 2.5rem;
	}
	.footer-brand strong {
		color: var(--ink);
		font-size: 1.05rem;
	}
	.footer-brand p {
		margin-top: 0.5rem;
		font-size: 0.88rem;
		color: var(--ink-subtle);
		max-width: 34ch;
	}
	.footer-links {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.footer-links h4 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-subtle);
		margin-bottom: 0.65rem;
	}
	.footer-links ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.footer-links a {
		color: var(--ink-muted);
		text-decoration: none;
		font-size: 0.88rem;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-bottom {
		max-width: var(--max-w);
		margin: 0 auto;
		padding: 1.1rem 1.25rem 2rem;
		border-top: 1px solid var(--border);
		font-size: 0.82rem;
		color: var(--ink-subtle);
	}
	@media (max-width: 720px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.footer-links {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
