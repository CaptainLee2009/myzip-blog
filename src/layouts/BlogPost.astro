---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, ctaZip } = Astro.props;
const targetZip = ctaZip || '94107';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} ogType="article" />
	</head>

	<body>
		<Header />
		<main class="article-main">
			<article>
				<header class="article-header">
					<a href="/blog" class="back-link">&larr; All stories</a>
					<div class="article-meta">
						{category && <span class="badge">{category}</span>}
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									&middot; Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<h1>{title}</h1>
					<p class="article-lead">{description}</p>
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<Image width={960} height={500} src={heroImage} alt={title} />
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<aside class="neighborhood-cta" aria-label="Explore MyZip">
					<div class="cta-text">
						<span class="badge">Live on my.zip</span>
						<h3>See what's happening in your neighborhood right now.</h3>
						<p>
							No account required to browse. Open a live local timeline or tap <strong>Interested</strong> on an
							upcoming neighborhood event.
						</p>
					</div>
					<div class="cta-actions">
						<a
							class="btn-primary"
							href={`https://my.zip/us/${targetZip}/events`}
							target="_blank"
							rel="noopener"
						>
							Browse {targetZip} Events &rarr;
						</a>
						<a class="btn-secondary" href="https://my.zip/us/94102/events" target="_blank" rel="noopener">
							SF 94102
						</a>
						<button type="button" class="btn-secondary" id="copy-story-link">Copy link</button>
					</div>
				</aside>
			</article>
		</main>
		<Footer />
		<script is:inline>
			const copyBtn = document.getElementById('copy-story-link');
			if (copyBtn && navigator.clipboard) {
				copyBtn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(window.location.href);
						const prev = copyBtn.textContent;
						copyBtn.textContent = 'Copied!';
						setTimeout(() => {
							copyBtn.textContent = prev;
						}, 1800);
					} catch {
						// ignore clipboard failure
					}
				});
			}
		</script>
	</body>
</html>
<style>
	.article-main {
		max-width: 820px;
	}
	.back-link {
		display: inline-block;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--ink-subtle);
		text-decoration: none;
		margin-bottom: 1.25rem;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.article-header {
		max-width: var(--prose-w);
		margin: 0 auto 2rem;
	}
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
		font-size: 0.88rem;
		color: var(--ink-subtle);
		margin-bottom: 0.85rem;
	}
	.updated {
		font-style: italic;
	}
	.article-header h1 {
		margin-bottom: 0.75rem;
	}
	.article-lead {
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--ink-muted);
		margin-bottom: 0;
	}
	.hero-image {
		margin: 0 auto 2.25rem;
	}
	.hero-image img {
		display: block;
		width: 100%;
		max-height: 460px;
		object-fit: cover;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		box-shadow: var(--shadow-md);
	}
	.prose {
		max-width: var(--prose-w);
		margin: 0 auto;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.35rem;
		margin: 0 0 1.35rem 0;
		color: var(--ink-muted);
	}
	.prose :global(li) {
		margin-bottom: 0.45rem;
	}
	.prose :global(strong) {
		color: var(--ink);
	}
	.neighborhood-cta {
		max-width: var(--prose-w);
		margin: 3rem auto 0;
		padding: 1.6rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--border);
		background: var(--surface);
	}
	.neighborhood-cta h3 {
		margin: 0.75rem 0 0.45rem;
		font-size: 1.3rem;
	}
	.neighborhood-cta p {
		font-size: 0.95rem;
		margin-bottom: 1.15rem;
	}
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}
</style>
